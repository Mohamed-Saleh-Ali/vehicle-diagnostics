# Copy to .env (never commit .env). All values are read and validated in src/config/index.ts
NODE_ENV=development
PORT=8080

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=vehicle-diagnostics

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# AI: MOCK_AI=1 → no LLM call, deterministic fake diagnosis (use while building + as demo backup)
MOCK_AI=1
# Any OpenAI-compatible provider (server only, never in the client). Default = Google Gemini free tier:
#   key: https://aistudio.google.com/apikey  · model id: see AI Studio (e.g. gemini-3.8-flash / a Flash-Lite model)
# Free alternatives: Groq  AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile
#                    Ollama (local, offline)  AI_BASE_URL=http://127.0.0.1:11434/v1  AI_MODEL=llama3.1:8b  AI_API_KEY=ollama
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.8-flash
# schema = strict JSON schema from zod (best) · json_object = plain JSON mode (fallback if a provider rejects the schema)
AI_JSON_MODE=schema
AI_TIMEOUT_MS=20000
# 1 = symptom text containing [simulate-error] returns a 502 (for the live demo of the error UI)
DEMO_ERROR_TRIGGER=1

# Seed accounts (used by `npm run seed`). Change the passwords before seeding Atlas!
SEED_ADMIN_EMAIL=admin@diagbay.dev
SEED_ADMIN_PASSWORD=Admin1234!
SEED_TECH_EMAIL=tech@diagbay.dev
SEED_TECH_PASSWORD=Tech1234!
